# Path of Exile developer app
# Register at https://www.pathofexile.com/developer
#
# Local sign-in uses a public client:
# redirect http://127.0.0.1:3000/api/auth/callback
# scopes: account:profile account:characters
# Open the site at http://127.0.0.1:3000
POE_CLIENT_ID=
POE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
POE_CONTACT_EMAIL=

# Required in production. Local development has a built-in fallback.
POE_SESSION_SECRET=

# Ladder ranks need a confidential client and these service scopes:
# service:leagues service:leagues:ladder
# Confidential clients cannot use 127.0.0.1. Leave this blank for local sign-in.
POE_CLIENT_SECRET=
